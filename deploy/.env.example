# SoloLedger Cloud — secrets (copy to .env, fill in)
# See docs/SECURITY.md and docs/plans/sololedger-v1-rearchitecture.md.

# ── REQUIRED for a public multi-tenant deployment ─────────────────────────

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret — https://dashboard.stripe.com/webhooks
# Endpoint: https://sololedger.ferrumeng.com/api/v1/stripe-webhook
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=

# Resend — transactional email (verification, password reset, receipts)
# https://resend.com/api-keys (free tier: 3,000 emails/mo)
RESEND_API_KEY=
RESEND_FROM=SoloLedger <welcome@sololedger.ferrumeng.com>

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Admin API key — Bearer token for /api/v1/admin/* (list/cancel/deprovision
# tenants). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Public app URL (used in emails and Stripe redirects)
APP_URL=https://sololedger.ferrumeng.com

# ── OPTIONAL features ─────────────────────────────────────────────────────

# Plaid (bank sync) — https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ACCESS_TOKEN=
PLAID_ENV=sandbox

# Toggl (time tracking)
TOGGL_API_TOKEN=

# Legacy desktop notifications (optional)
NOTIFY_SMTP_PASSWORD=

# PoolSplat co-hosted on this VPS (unrelated to SoloLedger)
FAL_KEY=
# PoolSplat AI photo editor backends
AGNES_API_KEY=
GEMINI_API_KEY=
NETDATA_EMAIL_SEND=
