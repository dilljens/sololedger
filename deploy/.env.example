# SoloLedger Cloud — secrets (copy to .env, fill in)
# See docs/plans/revenue-plan.md for full context.

# ── REQUIRED for SoloLedger Cloud ─────────────────────────────────────────────

# Google OAuth — Create at https://console.cloud.google.com/apis/credentials
# Web application, authorized JS origins: https://sololedger.ferrumeng.com
# Authorized redirect URIs: (leave blank for GSI)
GOOGLE_CLIENT_ID=

# Stripe — Create at https://dashboard.stripe.com/apikeys
# Use a restricted key with only "checkout.session.read" permission
STRIPE_SECRET_KEY=

# ── STRONGLY RECOMMENDED ──────────────────────────────────────────────────────

# Resend — transactional emails (welcome, payment receipts)
# Create API key at https://resend.com/api-keys (free: 3,000 emails/mo)
RESEND_API_KEY=
# From address — must be a domain you verified in Resend
# RESEND_FROM=SoloLedger <welcome@sololedger.ferrumeng.com>

# Email alerts (legacy NOTIFY system — optional, Gmail app password)
# Only needed for CLI desktop notifications (not for the cloud service)
NOTIFY_SMTP_PASSWORD=

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Plaid (for automated bank feeds)
# Get started at https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ACCESS_TOKEN=
PLAID_ENV=sandbox

# Toggl (for time tracking)
TOGGL_API_TOKEN=

# PoolSplat — fal.ai API key for AI photo editing
# Get one at https://fal.ai/dashboard
FAL_KEY=

# Netdata — email alerts (optional, uses sendmail)
# If unset, Netdata runs without email notifications
NETDATA_EMAIL_SEND=
# NETDATA_EMAIL_TO=dillon@ferrumengineeringllc.com
